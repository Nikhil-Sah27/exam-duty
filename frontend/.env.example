# Copy to .env.local and edit if your backend isn't on the default port.
#
# The two variables below are not interchangeable: one configures the Vite
# server (Node side), the other configures the app running in the browser.

# Where the Vite dev/preview server forwards /api/* — must match backend PORT.
# Read by vite.config.ts only; never bundled into the client.
# Defaults to http://localhost:5001 when unset.
DEV_API_PROXY_TARGET=http://localhost:5001

# The axios baseURL the client itself requests (frontend/src/shared/lib/api.ts).
# Defaults to "/api" — same-origin, which the proxy above serves in dev and
# preview. Set it only for a build served without that proxy in front of it,
# against a backend on another origin, e.g.
# VITE_API_URL=https://api.example.edu/api
